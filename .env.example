# Copy this file to .env and replace every placeholder before running the app.
# .env is gitignored; never commit real values.

# PostgreSQL user that docker-compose.yml creates on first start.
POSTGRES_USER=registry
# PostgreSQL password for that user; pick any strong value.
POSTGRES_PASSWORD=change-me
# Host port for PostgreSQL; change it if 5432 is already in use.
POSTGRES_PORT=5432

# Development database the app and the seed use (same user, password, and port as above).
DATABASE_URL=postgresql://registry:change-me@localhost:5432/registry
# Separate database that the integration and Playwright tests reset on every run.
TEST_DATABASE_URL=postgresql://registry:change-me@localhost:5432/registry_test

# Secret that signs session cookies; generate one with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret

# Password given to every seeded demo account (staff and students); at least 8 characters.
SEED_USER_PASSWORD=choose-a-demo-password

# Folder where uploaded submission files are stored; keep it outside public/.
UPLOAD_DIR=./uploads
# Time zone used for "today" (fee due dates) and for showing deadlines.
APP_TIMEZONE=Europe/London
# ISO 4217 currency code used to show money amounts.
APP_CURRENCY=GBP
